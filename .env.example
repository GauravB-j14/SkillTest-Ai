# Copy to .env.local and add your key. Never use NEXT_PUBLIC_ for this secret.
GEMINI_API_KEY=your_gemini_api_key
# Optional; use a currently supported model available to your account
GEMINI_MODEL=gemini-3.6-flash
# Optional: set DATABASE_URL to a hosted Postgres connection string (for Render, use its internal URL).
# Without DATABASE_URL, development uses a local SQLite file.
